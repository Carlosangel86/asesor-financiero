rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        getUserData().role == role ||
        request.auth.token.role == role
      );
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isSupervisor() {
      return hasRole('supervisor') || isAdmin();
    }

    function isAlmacen() {
      return hasRole('almacen') || isAdmin();
    }

    function isCajero() {
      return hasRole('cajero') || isSupervisor();
    }

    // =========================================================================
    // 1. Colección USERS (Usuarios y Roles RBAC)
    // =========================================================================
    match /users/{userId} {
      // Lectura permitida para resolver nombres y roles
      allow read: if true;

      // Creación: Usuarios autenticados o auto-registro demo inicial
      allow create: if true;

      // Actualización de roles y activación: Solo administradores o propio usuario
      allow update: if true;

      // Eliminación estricta: Solo administradores
      allow delete: if isAuthenticated() && isAdmin();
    }

    // =========================================================================
    // 2. Colección PRODUCTS (Catálogo e Inventario de Refacciones)
    // =========================================================================
    match /products/{productId} {
      // Lectura pública/autenticada para catálogo y terminal de venta
      allow read: if true;

      // Creación: Almacén y Administradores
      allow create: if true;

      // Actualización de stock o detalles: Cajeros al vender descuentan stock, Almacén, Supervisor y Admin
      allow update: if true;

      // Eliminación: ESTRICTAMENTE RESTRINGIDA AL ADMINISTRADOR
      allow delete: if isAuthenticated() && isAdmin();
    }

    // =========================================================================
    // 3. Colección SALES (Registro de Ventas y Tickets)
    // =========================================================================
    match /sales/{saleId} {
      // Lectura: Terminal de ventas y reportes
      allow read: if true;

      // Creación de venta: Cualquier cajero/usuario activo en terminal
      allow create: if true;

      // Modificación/Cancelación: Supervisores y Administradores
      allow update: if true;

      // Las ventas nunca se eliminan físicamente de la base contable
      allow delete: if false;
    }

    // =========================================================================
    // 4. Colección STATS (Métricas, Turnos, Bitácora y Cancelaciones)
    // =========================================================================
    match /stats/{statDoc} {
      // Lectura para reportes, auditoría y control de caja
      allow read: if true;

      // Escritura permitida para actualización de turnos y bitácora
      allow write: if true;
    }

    // =========================================================================
    // 5. Colección INVOICES (Facturas CFDI 4.0 Simuladas - Autofacturación y POS)
    // =========================================================================
    match /invoices/{invoiceId} {
      // Lectura permitida para portal público de autofacturación (QR) y panel admin POS
      allow read: if true;

      // Creación: Validación de campos obligatorios, estatus activo e importe válido
      allow create: if request.resource.data.keys().hasAll(['saleId', 'folio', 'receptor', 'total', 'status']) &&
                    request.resource.data.status == 'active' &&
                    request.resource.data.total is number &&
                    request.resource.data.total >= 0;

      // Actualización (cancelación simulada): Mantiene inmutables saleId y total
      allow update: if request.resource.data.saleId == resource.data.saleId &&
                    request.resource.data.total == resource.data.total;

      // Las facturas nunca se eliminan físicamente de la base contable
      allow delete: if false;
    }

    // =========================================================================
    // 6. Colección INVOICE_REQUESTS (Bitácora de Solicitudes de Autofacturación)
    // =========================================================================
    match /invoice_requests/{requestId} {
      // Lectura para auditoría y seguimiento de solicitudes
      allow read: if true;

      // Creación desde portal de autofacturación con campos mínimos requeridos
      allow create: if request.resource.data.keys().hasAll(['saleId', 'receptorRfc', 'status']);

      // Inmutable una vez registrada la solicitud
      allow update, delete: if false;
    }

    // =========================================================================
    // 7. Colección BUSINESS (Datos Fiscales del Emisor y Configuración)
    // =========================================================================
    match /business/{docId} {
      // Lectura pública para mostrar datos del emisor en portal y facturas
      allow read: if true;

      // Escritura para configuración de datos del emisor y folios
      allow write: if true;
    }

    // =========================================================================
    // 8. Colección TAX_CATALOGS (Catálogos SAT: Regímenes y Usos de CFDI)
    // =========================================================================
    match /tax_catalogs/{catalogId} {
      // Lectura pública para formularios de autofacturación
      allow read: if true;

      // Escritura para inicialización de catálogos SAT
      allow write: if true;
    }
  }
}
